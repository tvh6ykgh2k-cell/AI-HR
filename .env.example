# 复制本文件为 .env.local（项目根目录），填入真实值。后端在启动时自动加载 .env.local。

# Agnes AI API（OpenAI 兼容端点）
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=your-a...-key
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash

# Obsidian Vault（面试逐字稿 / 工单自动存档目标；指向含 .obsidian 的 vault 根目录）
# 存档文件写入 <OBSIDIAN_VAULT_PATH>\sessions\
OBSIDIAN_VAULT_PATH=J:\MyObsidianVault\PM 面试
